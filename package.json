{
  "name": "campus-bazaar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "npm --prefix frontend run dev -- --host 0.0.0.0",
    "server": "node backend/server.js",
    "server:watch": "node --watch backend/server.js",
    "seed:products": "node backend/seed.js",
    "dev:server": "npm run server:watch",
    "dev:all": "npm run dev",
    "build": "npm --prefix frontend run build",
    "client:build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview -- --host 0.0.0.0",
    "install:client": "npm --prefix frontend install",
    "install:all": "npm install && npm run install:client",
    "test": "npm --prefix frontend run test",
    "lint": "npm --prefix frontend run lint",
    "type-check": "npm --prefix frontend run type-check"
  },
  "dependencies": {
    "bcryptjs": "^3.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.0.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.2",
    "tsx": "^4.20.6"
  },
  "engines": {
    "node": ">=22"
  }
}
